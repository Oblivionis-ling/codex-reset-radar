# Local-only configuration. Never commit the real .env file.
RADAR_DB_PATH=backend/data/radar.db
RADAR_BACKEND_HOST=127.0.0.1
RADAR_BACKEND_PORT=8787

# Reserved for the intelligence phase.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROMPT_VERSION=tibo-classifier-v2-calibrated

# Phase C notifications. Keep secrets only in the local .env file.
ALERTS_ENABLED=true
ALERT_DRY_RUN=true
WXPUSHER_ENABLED=false
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=
WINDOWS_NOTIFICATIONS_ENABLED=false

# GitHub mirror uses the local GitHub CLI/keyring. Do not put a token here.
GITHUB_OWNER=oblivionis-ling
GITHUB_REPO=codex-reset-radar
GITHUB_MIRROR_ENABLED=true
GITHUB_MIRROR_INTERVAL_SECONDS=300
