# Backend
CRR_HOST=127.0.0.1
CRR_PORT=8787
CRR_DATABASE_PATH=runtime/data/codex-reset-radar-v2.db

# Runtime and logging
CRR_LOG_DIR=runtime/logs
CRR_LOG_RETENTION_DAYS=5
CRR_LOG_MAX_BYTES=5242880
CRR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CRR_BUILD_COMMIT=

# DeepSeek (reserved for a later Intelligence phase; no Judge is enabled in Alpha 1)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Transitional collector adapter
COLLECTOR_SHARED_TOKEN=

# Notifications (provider retained; production rules are not enabled in Alpha 1)
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=
WINDOWS_TOAST_ENABLED=false

# Future deployment
CRR_PUBLIC_BASE_URL=
