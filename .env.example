# Backend
CRR_HOST=127.0.0.1
CRR_PORT=8787
CRR_DATABASE_PATH=runtime/data/codex-reset-radar-v2.db

# Runtime and logging
CRR_LOG_DIR=runtime/logs
CRR_LOG_RETENTION_DAYS=5
CRR_LOG_MAX_BYTES=5242880
CRR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CRR_BUILD_COMMIT=

# DeepSeek intelligence pipeline
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_RETRIES=2
CRR_JUDGE_INTERVAL_SECONDS=3600

# Transitional collector adapter
COLLECTOR_SHARED_TOKEN=

# Notifications (optional; not connected to Reset/Judge automation in Alpha 4)
PUSHPLUS_TOKEN=
SERVERCHAN_SENDKEY=
IYUU_TOKEN=
WPUSH_API_KEY=
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=
SHOWDOC_PUSH_TOKEN=
CRR_NOTIFICATION_TIMEOUT_SECONDS=10
CRR_NOTIFICATION_HTTP_RETRIES=1
CRR_NOTIFICATION_LEDGER=runtime/notifications/notification-deliveries.db

# Independent SMTP fallback. TLS certificate verification is always enabled.
CRR_SMTP_HOST=
CRR_SMTP_PORT=587
CRR_SMTP_USERNAME=
CRR_SMTP_PASSWORD=
CRR_SMTP_FROM=
CRR_SMTP_TO=
CRR_SMTP_SECURITY=starttls

# Legacy V1-only setting; not used by the active V2 notification preparation.
WINDOWS_TOAST_ENABLED=false

# Future deployment
CRR_PUBLIC_BASE_URL=
