# V2 runtime state is never versioned.
runtime/*
!runtime/README.md
data/analysis/*
!data/analysis/README.md
data/corpus/*
!data/corpus/README.md
*.db
*.db-*
*.sqlite
*.sqlite-*
*.jsonl

# Reproducible frontend and extension artifacts are built by CI.
node_modules/
dist/
apps/**/node_modules/
apps/**/dist/
dashboard/node_modules/
dashboard/dist/
extension/node_modules/
extension/dist/

